@@ -0,0 +1,100 @@
+import { sessionKeyOf } from './session-id.js';
+const aliases = { '/help':'帮助', '/帮助':'帮助', '/new':'新对话', '/clear':'新对话', '/新对话':'新对话', '/history':'历史', '/历史':'历史', '/switch':'切换', '/切换':'切换', '/projects':'项目', '/项目':'项目', '/model':'模型', '/模型':'模型', '/continue':'继续', '/继续':'继续', '/compact':'压缩', '/压缩':'压缩', '/rename':'重命名', '/重命名':'重命名', '/quota':'额度', '/额度':'额度', '/cancel':'取消', '/取消':'取消', '/idle':'空闲', '/空闲':'空闲', '/策略':'策略' };
+const help = '直接发消息继续当前会话。\n/新对话 [项目序号或 ID]\n/项目 查看项目\n/历史 查看本聊天历史\n/切换 序号或会话 ID\n/模型 [序号或模型 ID]\n/继续 继续空闲前的会话\n/压缩 压缩当前上下文\n/重命名 新名称\n/额度 查看当前模型额度\n/空闲 分钟（0 表示不检查）\n/策略 询问、继续或新建\n/取消 取消待续接消息或停止当前执行\n/帮助';
+const choice = (rows, value) => rows.find((row) => row.id === value) || (/^[1-9]\d*$/.test(value) ? rows[Number(value)-1] : undefined);
+export async function handleWorkagentCommand(engine, channel, msg) {
+  const [raw, ...parts] = msg.text.trim().split(/\s+/);
+  const command = aliases[raw.toLowerCase()];
+  if (!command) return undefined;
+  const service = engine.ctx.get('workagentChannels');
+  const config = engine.resolveConfig(channel.id);
+  if (!service.handles(config.provider)) return undefined;
+  const argument = parts.join(' ');
+  const kind = msg.kind === 'group' ? 'group' : 'dm';
+  const key = sessionKeyOf(channel.id, kind, msg.chatId);
+  if (command === '帮助') return help;
+  if (command === '项目') return service.projects().map((row,index)=>`${index+1}. ${row.name} (${row.id})`).join('\n') || '暂无项目。';
+  const history = () => service.history(key);
+  if (command === '历史' || (command === '切换' && !argument)) return history().map((row,index)=>`${index+1}. ${row.title} (${row.id})`).join('\n') || '本聊天暂无历史会话。';
+  const binding = await engine.router.getOrCreate(channel.id,kind,msg.chatId,msg.username || msg.chatId);
+  const saved = engine.store.get(key);
+  if (saved?.pendingInput?.userId && saved.pendingInput.userId !== msg.userId && ['继续','取消','新对话'].includes(command)) return '请由发送待续接消息的用户选择。';
+  const update = (values) => engine.store.upsert(key,{...engine.store.get(key),...values});
+  if (engine.questions.has(binding.sessionId) || engine.broker.has(binding.sessionId)) return '请先完成当前问题或审批。';
+  if (command === '空闲') {
+    const minutes=Number(argument);
+    if(!argument || !Number.isInteger(minutes) || minutes<0 || minutes>10080) return '用法：/空闲 分钟，范围 0–10080；0 表示不检查。';
+    update({idleMinutes:minutes}); return `空闲检查已设置为 ${minutes} 分钟。`;
+  }
+  if(command==='策略') {
+    if(!['询问','继续','新建'].includes(argument)) return '用法：/策略 询问、继续或新建';
+    update({idlePolicy:argument}); return `空闲后将${argument}。`;
+  }
+  if(command==='取消') {
+    if(saved?.pendingInput){update({pendingInput:null,lastInputAt:new Date().toISOString()});return '已取消待续接消息。';}
+    await service.cancel(key,binding.sessionId); return '已请求停止当前执行。';
+  }
+  if(command==='继续') {
+    update({pendingInput:null,lastInputAt:new Date().toISOString()});
+    try { await engine.inject(channel,{...(saved?.pendingInput || {...msg,text:'请继续当前任务。'}),workagentContinue:true}); }
+    catch(error) { if(saved?.pendingInput) update({pendingInput:saved.pendingInput}); throw error; }
+    return '已继续当前会话。';
+  }
+  if(command==='重命名') {
+    if(!argument) return '用法：/重命名 新名称';
+    await service.rename(key,binding.sessionId,argument); engine.router.rename(binding.sessionId,argument); return `已重命名为 ${argument}`;
+  }
+  if(command==='额度') {
+    const value=await service.quota(key,binding.sessionId);
+    return `当前模型额度（${value.period}）：上限 ${value.limitUnits}，已用 ${value.consumedUnits}，预留 ${value.reservedUnits}。`;
+  }
+  if(command==='压缩') { await service.compact(key,binding.sessionId); return '已提交上下文压缩。'; }
+  if(command==='模型') {
+    const catalog=await service.sessionModels(key,binding.sessionId);
+    const models=catalog.groups.flatMap((group)=>group.models);
+    if(!argument) return `当前模型：${catalog.current.model}\n`+models.map((row,index)=>`${index+1}. ${row.name} (${row.id})`).join('\n');
+    const selected=choice(models,argument); if(!selected) return '没有找到这个模型，请先发送 /模型。';
+    const workagentConfig=await service.selectModel(key,binding.sessionId,selected.id); update({workagentConfig}); return `已切换到 ${selected.name}`;
+  }
+  if(history().find((row)=>row.id===binding.sessionId)?.active) return '当前会话仍在运行，请停止或等待完成后切换。';
+  let handle, workagentConfig;
+  if(command==='切换') {
+    const selected=choice(history(),argument); if(!selected) return '没有找到本聊天的这个历史会话。';
+    if(selected.active) return '目标会话仍在运行，请稍后再切换。';
+    if(selected.id===binding.sessionId) return '已是当前会话。';
+    handle=await service.resume(key,selected.id);
+    workagentConfig=service.configuration(key,selected.id);
+  } else if(command==='新对话') {
+    workagentConfig=saved?.workagentConfig || config;
+    if(argument){const project=choice(service.projects(),argument);if(!project)return '没有找到项目，请先发送 /项目。';workagentConfig={...workagentConfig,cwd:project.cwd};}
+    handle=await service.open(workagentConfig,undefined,msg.username || msg.chatId,key);
+  } else return undefined;
+  if(!handle) return '暂时无法打开目标会话。';
+  await binding.handle?.dispose();
+  engine.router.live.set(key,{...binding,sessionId:handle.sessionId,handle});
+  update({sessionId:handle.sessionId,title:service.history(key).find((row)=>row.id===handle.sessionId)?.title || saved?.title,workagentConfig,pendingInput:null,lastInputAt:new Date().toISOString(),updatedAt:new Date().toISOString()});
+  if(command==='新对话' && saved?.pendingInput) {
+    try { await engine.inject(channel,{...saved.pendingInput,workagentContinue:true}); }
+    catch(error) { update({pendingInput:saved.pendingInput}); throw error; }
+  }
+  return `已${command==='新对话'?'新建':'切换'}会话：${handle.sessionId}`;
+}
+
+export async function checkWorkagentIdle(engine,channel,msg,binding) {
+  if(!binding.handle?.workagent || msg.workagentContinue) return true;
+  const record=engine.store.get(binding.key);
+  const service=engine.ctx.get('workagentChannels');
+  const history=service.history(binding.key).find((row)=>row.id===binding.sessionId);
+  const minutes=record?.idleMinutes ?? 30;
+  const last=Math.max(Date.parse(record?.lastInputAt || '') || 0,Date.parse(history?.updatedAt || '') || 0);
+  if(!record?.lastInputAt || !minutes || history?.active || Date.now()-last<minutes*60000) return true;
+  const pending=record.pendingInput;
+  if(pending){await channel.send(msg.chatId,'已有一条待续接消息。请先发送 /继续、/新对话 或 /取消。');return false;}
+  if(record.idlePolicy==='继续') return true;
+  engine.store.upsert(binding.key,{...record,pendingInput:msg});
+  if(record.idlePolicy==='新建') {
+    const reply=await handleWorkagentCommand(engine,channel,{...msg,text:'/新对话'});
+    if(reply) await channel.send(msg.chatId,reply);
+  } else await channel.send(msg.chatId,`会话已空闲超过 ${minutes} 分钟。消息已暂存，请发送 /继续、/新对话 或 /取消。`);
+  return false;
+}
