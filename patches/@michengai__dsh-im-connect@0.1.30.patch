diff --git a/lib/engine/workagent-host.js b/lib/engine/workagent-host.js
new file mode 100644
--- /dev/null
+++ b/lib/engine/workagent-host.js
@@ -0,0 +1,46 @@
+import { isImSessionId } from './session-id.js';
+
+// Compatibility boundary for @michengai/dsh-im-connect 0.1.30. Only this
+// adapter reaches the engine's private router/store/interaction registries.
+// Commands and notification policies consume this port, never the engine.
+export function createWorkagentHost(engine, { service = engine.ctx.get('workagentChannels'), store = engine.store } = {}) {
+  const replaceBinding = async (key, binding, handle) => {
+    await binding.handle?.dispose();
+    engine.router.live.set(key, { ...binding, sessionId: handle.sessionId, handle });
+  };
+  return {
+    service,
+    configuration: channelId => engine.resolveConfig(channelId),
+    record: key => store.get(key),
+    update: (key, values) => store.upsert(key, { ...store.get(key), ...values }),
+    history: key => service.history(key).filter(row => !engine.router.isArchived?.(row.id)),
+    binding: (channel, msg) => engine.router.getOrCreate(channel.id, msg.kind === 'group' ? 'group' : 'dm', msg.chatId, msg.username || msg.chatId),
+    managed: binding => Boolean(binding.handle?.workagent),
+    awaitingInteraction: sessionId => engine.questions.has(sessionId) || engine.broker.has(sessionId),
+    inject: (channel, message) => engine.inject(channel, message),
+    rename: (sessionId, title) => engine.router.rename(sessionId, title),
+    replaceBinding,
+    async resumeLive(key, sessionId) {
+      const binding = engine.router.live.get(key);
+      if (!binding?.handle) return true;
+      const handle = await service.resume(key, sessionId);
+      if (!handle) return false;
+      await replaceBinding(key, binding, handle);
+      return true;
+    },
+    recordInput(binding) {
+      if (binding.handle?.workagent) store.upsert(binding.key, { ...store.get(binding.key), lastInputAt: new Date().toISOString() });
+    },
+    async followup(binding, message) {
+      if (binding.handle?.workagent) await binding.handle.followup(message, event => engine.onSessionEvent({ id: binding.sessionId }, event, binding));
+      else engine.router.followup(binding, message);
+    },
+    interactionBinding(sessionId) {
+      if (service.listSessionIds().includes(sessionId)) {
+        const key = service.activeChannel(sessionId);
+        return key ? engine.router.live.get(key) : undefined;
+      }
+      return isImSessionId(sessionId) ? engine.router.bindingForSession(sessionId) : undefined;
+    },
+  };
+}
diff --git a/lib/engine/workagent-notifications.js b/lib/engine/workagent-notifications.js
new file mode 100644
--- /dev/null
+++ b/lib/engine/workagent-notifications.js
@@ -0,0 +1,30 @@
+import { sessionKeyOf } from './session-id.js';
+
+// Delivery already succeeded. A completion may choose the next reply target,
+// but must not take over pending input, a selection, or a running task.
+export async function rebindNotificationTarget(runtime, target, sessionId) {
+  const { service } = runtime;
+  const key = sessionKeyOf(target.channelId, target.kind, target.chatId);
+  const record = runtime.record(key);
+  if (!record || !service.handles(runtime.configuration(target.channelId).provider)) return;
+  if (sessionId.startsWith('collaboration:')) {
+    if (record.pendingInput || record.pendingSelection) return;
+    const conversationId = sessionId.slice(14);
+    await service.collaboration.access(conversationId);
+    runtime.update(key, { collaboration: { conversationId } });
+    return;
+  }
+  const now = new Date().toISOString();
+  if (record.pendingInput) return;
+  if (record.sessionId === sessionId) {
+    runtime.update(key, { collaboration: null, lastInputAt: now, updatedAt: now });
+    return;
+  }
+  if (!service.listSessionIds().includes(sessionId)) return;
+  const current = service.history(key).find(row => row.id === record.sessionId);
+  if (current?.active) return;
+  const title = service.history(key).find(row => row.id === sessionId)?.title || record.title;
+  const workagentConfig = service.configuration(key, sessionId);
+  if (!await runtime.resumeLive(key, sessionId)) return;
+  runtime.update(key, { collaboration: null, sessionId, title, workagentConfig, pendingSelection: null, lastInputAt: now, updatedAt: now });
+}
