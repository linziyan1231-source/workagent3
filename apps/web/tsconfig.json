{
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["react", "react-dom", "vite/client", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts"]
}
