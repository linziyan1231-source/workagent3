{
  "name": "workagent3",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm go:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "go:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/go.ps1 test ./...",
    "profile:dump": "pnpm --filter @workagent/harness-bundle build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dump-harness-profile.ps1",
    "profile:smoke": "pnpm profile:dump && node scripts/smoke-harness.mjs",
    "native:smoke": "pnpm --filter @workagent/harness-bundle build && node scripts/smoke-native-engines.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
